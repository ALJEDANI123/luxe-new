  "whatsapp_greeting": "\u0645\u0631\u062d\u0628\u0627\u064b! \u0623\u0646\u0627 \u0645\u0633\u0627\u0639\u062f BagiLand \ud83c\udfaa\n\n\u0623\u0642\u062f\u0631 \u0623\u0633\u0627\u0639\u062f\u0643 \u0641\u064a:\n\u2022 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a (\u0625\u0636\u0627\u0641\u0629\u060c \u062a\u0639\u062f\u064a\u0644\u060c \u062d\u0630\u0641)\n\u2022 \u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0645\u0646\u062a\u062c\u0627\u062a\n\u2022 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0639\u0644\u0649 \u0623\u0633\u0626\u0644\u062a\u0643\n\n\u0643\u064a\u0641 \u0623\u0642\u062f\u0631 \u0623\u062e\u062f\u0645\u0643\u061f",
  "name": "bagiland_assistant"
